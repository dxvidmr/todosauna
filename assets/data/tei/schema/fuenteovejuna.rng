            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(function) caracteriza la función de un segmento.</a:documentation>
            <data type="token">
               <param name="pattern">[^\p{C}\p{Z}]+</param>
            </data>
         </attribute>
      </optional>
   </define>
