# Ignore metadata generated by Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore folders generated by Bundler
.bundle/
vendor/

# Ignore mac files 
.DS_Store

# objects/: solo se versionan las miniaturas (small/ y thumbs/) que copia
# fuenteovejuna-data; el resto de archivos de objetos no se sube.
objects/*
!objects/small/
!objects/thumbs/
# Copia propia servida a tamaño completo porque su archivo (ELIA) solo responde por http (2-11-2026).
!objects/fo-0c82dp.jpg

# Local environment files / secrets
.env
.env.*
!.env.example
tmpclaude-*
nul

# Supabase CLI local cache
supabase/.temp/

# Node / Playwright test artifacts
node_modules/
playwright-report/
test-results/
